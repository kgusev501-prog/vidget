{
  "name": "vidget",
  "version": "0.1.0",
  "description": "iOS-style pull-down overlay widget for Windows 11: Yandex Music, clipboard history, notes",
  "main": "src/main/index.js",
  "scripts": {
    "start": "node tools/start.js",
    "dev": "node tools/start.js --dev",
    "icons": "node tools/make-icons.js",
    "dist": "electron-builder --win --config electron-builder.config.js",
    "dist:portable": "electron-builder --win --dir --config electron-builder.config.js -c.win.signAndEditExecutable=false",
    "predist": "node tools/prepare-signtool.js",
    "test": "node --test \"test/**/*.test.js\"",
    "release": "electron-builder --win --config electron-builder.config.js --publish always"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kgusev501-prog/vidget.git"
  }
}
